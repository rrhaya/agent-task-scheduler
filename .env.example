# Copy to .env (ignored by Git). Use literal absolute paths; no shell expansion.
AGENT_SCHEDULER_CONFIG=examples/personal-scheduler.json
AGENT_TASK_REPOSITORY=YOUR_NAME/YOUR_REPOSITORY
AGENT_TASK_WORKSPACE=/absolute/path/to/local/checkout
AGENT_TASK_STATE_DIR=/absolute/path/to/private/state
AGENT_TASK_LABEL=agent-ready
AGENT_TASK_MAX_PARALLEL=3
AGENT_TASK_POLL_INTERVAL_MS=60000
AGENT_TASK_RESERVE_PERCENT=20
AGENT_TASK_WEEKLY_RESERVE_PERCENT=30
AGENT_TASK_CODEX_COMMAND=codex

# Any JSON string value supports ${NAME} and ${NAME:-default}.
# For additional sources/adapters, use variables in a scheduler.local.json file:
# AGENT_TASK_MARKDOWN_DIR=/absolute/path/to/task-folder
# AGENT_TASK_JSON_FILE=/absolute/path/to/tasks.json
# AGENT_TASK_CLAUDE_COMMAND=claude
# AGENT_TASK_CLAUDE_MODEL=your-configured-model
# AGENT_TASK_QUOTA_HELPER=/absolute/path/to/limitping
# Do not put live tokens in .env.example. Saved vendor CLI logins are preferred.
